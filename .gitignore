# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
.Python
# Anchored to the repo root: `dist/` unanchored would also swallow the
# committed admin SPA at trench/web/dist.
/build/
/dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtualenvs
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/
.tox/

# ── Node (admin console) ────────────────────────────────────────────────────
node_modules/
*.tsbuildinfo
.vite/

# ── Runtime state — never source ────────────────────────────────────────────
# These are produced by a running server and routinely contain private data:
# the query log records every hostname a client on the LAN looked up, and
# app_user/api_token hold credential material.
data/*.shm
# compiled block table, rebuilt from the sources on every refresh
data/*.table
# `cache.persist` and `cache.prewarm` write these, and both are a list of the
# names this household actually resolved — the same private data as the query
# log, in a file whose extension does not announce it. Neither exists until an
# operator turns those settings on, which is exactly when a stray `git add -A`
# in a checkout would sweep one in.
data/cache.json
data/popularity.json
# the one-time admin password written on first start (mode 0600)
data/initial-admin-password
data/certs/
*.db
*.db-wal
*.db-shm

# TLS material of any kind.
*.pem
*.key
*.crt
*.p12
*.pfx

# ── Local configuration ─────────────────────────────────────────────────────
# trench.example.yaml is the documented template that ships. A real
# trench.yaml describes somebody's actual network and stays local.
/trench.yaml
/config.json
*.local.yaml
*.local.yml

# ── Superseded work kept only on the author's disk ──────────────────────────
backup/

# ── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# ── Docs ────────────────────────────────────────────────────────────────────
site/

# Editor and tooling configuration that is not this project.
.claude/
