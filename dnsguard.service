[Unit]
Description=DNSGuard DNS server
Documentation=https://github.com/OWNER/dnsguard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/dnsguardd --config /etc/dnsguard/dnsguard.yaml
Restart=on-failure
RestartSec=2
# SIGHUP re-reads the config and refreshes the lists without dropping
# in-flight queries or rebinding sockets.
ExecReload=/bin/kill -HUP $MAINPID
# Bind :53/:853 without running as full root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
User=dnsguard
Group=dnsguard
StateDirectory=dnsguard
# --- sandboxing ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/var/lib/dnsguard /etc/dnsguard

[Install]
WantedBy=multi-user.target
